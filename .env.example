# ─── General ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# SQLite (default) or PostgreSQL: postgres://user:pass@host:5432/ddi
DATABASE_URL=file:./data/app.db

# ─── Public bot info (shown on the website) ────────────────────────────────
BOT_PROFILE_URL=https://steamcommunity.com/id/deadlockpapi/
BOT_STEAM_ID=
COMMENT_PHRASE=thank you papi
# Public repository URL, shown in the footer and FAQ (leave empty to hide)
SOURCE_CODE_URL=

# ─── Steam login (bot account only - never your main account) ──────────────
# Recommended: run `npm run steam:login` once; it stores a refresh token in STEAM_TOKEN_FILE.
STEAM_TOKEN_FILE=./data/steam-refresh-token.txt
STEAM_REFRESH_TOKEN=
# Optional alternative (password login). Only used if no refresh token exists.
STEAM_ACCOUNT_NAME=
STEAM_PASSWORD=
# Optional: the bot's own Steam Guard shared_secret (from your authenticator export) for unattended re-login.
STEAM_SHARED_SECRET=

# ─── Deadlock invites ──────────────────────────────────────────────────────
# gc     = automated invites via the Deadlock Game Coordinator (bot account must have Deadlock access)
# manual = bot handles comments/friends, an admin sends invites from the game and confirms in /admin
# mock   = local testing only, refused when NODE_ENV=production
INVITE_PROVIDER=manual
DEADLOCK_APP_ID=1422450
DEADLOCK_INVITE_LOCATION=
INVITE_RESPONSE_TIMEOUT_SECONDS=30
NOT_FRIENDS_LONG_ENOUGH_RETRY_MINUTES=60

# ─── Worker behaviour & safety limits ──────────────────────────────────────
COMMENT_POLL_INTERVAL_SECONDS=60
COMMENT_MAX_AGE_HOURS=72
WORKER_TICK_SECONDS=15
REMOVAL_DELAY_SECONDS=300
FRIENDSHIP_WAIT_DAYS=7
MAX_ATTEMPTS=6
MAX_INVITES_PER_HOUR=20
MAX_FRIEND_ACTIONS_PER_HOUR=30
# Limited accounts cannot send friend requests; users send them instead (recommended: false).
BOT_SEND_FRIEND_REQUESTS=false
DECLINE_UNKNOWN_FRIEND_REQUESTS=false
WORKER_HEALTH_PORT=3001

# ─── Admin dashboard ───────────────────────────────────────────────────────
# Generate both with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Secure cookies default to on in production (requires HTTPS). Set false only for local HTTP testing.
COOKIE_SECURE=
# true when running behind Caddy/nginx so rate limits use X-Forwarded-For
TRUST_PROXY=false

# ─── Mock provider (development only) ──────────────────────────────────────
MOCK_REJECT_IDS=
MOCK_UNCERTAIN_IDS=

# ─── Docker / Caddy ────────────────────────────────────────────────────────
DOMAIN=invites.example.com
